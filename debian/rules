#!/usr/bin/make -f
# NatAmbio Debian packaging.
#
# The autotools build (SUBDIRS = lib src tools/xtc_filters
# tools/ladspa_nae_natambio ...) builds the JACK client, the two C XTC
# generators (symmetric and asymmetric), the LADSPA plugin and installs the
# Python toolkits. Everything is staged into debian/tmp and split into the
# binary packages via the *.install files.
#
# dh_missing aborts on anything staged but unpackaged (the default in compat
# 13), so every new binary or toolkit file has to gain a line in some
# *.install -- or in debian/not-installed if the omission is deliberate.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)
TMP := debian/tmp
SHAREDIR := $(TMP)/usr/share/natambio
BINDIR := $(TMP)/usr/bin

%:
	dh $@

override_dh_auto_install:
	dh_auto_install
	# The C XTC generators are installed by dh_auto_install via
	# tools/xtc_filters/Makefile.am (bin_PROGRAMS), staged into debian/tmp and
	# split into natambio-tools by debian/natambio-tools.install. Their
	# pure-Python counterparts come from tools/python_xtc_filters/Makefile.am
	# and go to natambio-drc, which already carries the Python dependencies.
	# --- LADSPA plugin -> multiarch ladspa dir (natambio-ladspa) ---
	install -D -m0644 tools/ladspa_nae_natambio/ladspa_nae_natambio.so \
	    $(TMP)/usr/lib/$(DEB_HOST_MULTIARCH)/ladspa/ladspa_nae_natambio.so
	# --- Python toolkits + /usr/bin wrappers (natambio-drc) ---
	# Staged by dh_auto_install via tools/python_pca4drc/Makefile.am and
	# tools/python_nae_natambio/Makefile.am, which install the toolkits to
	# $(SHAREDIR)/python_* (scripts, config.drc, measurement XMLs, target/
	# config/ mic/) and generate the /usr/bin/natambio-* launchers. No manual
	# copy here keeps a single source of truth for the install layout.
	# --- example XML configurations (natambio) ---
	install -d $(SHAREDIR)/examples
	install -m0644 docs/config_samples/*.xml    $(SHAREDIR)/examples/

# zita-convolver ships no .so version symlink consumed via pkg-config; nothing
# special needed for dh_shlibdeps.
